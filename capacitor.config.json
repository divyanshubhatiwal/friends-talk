{
  "appId": "live.friendstalk.app",
  "appName": "Friends Talk",
  "webDir": "www",
  "backgroundColor": "#0f0b0d",
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false,
    "backgroundColor": "#0f0b0d"
  },
  "android": {
    "backgroundColor": "#0f0b0d",
    "allowMixedContent": false
  },
  "server": {
    "iosScheme": "https",
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "backgroundColor": "#0f0b0d",
      "showSpinner": false,
      "launchAutoHide": true
    }
  }
}
