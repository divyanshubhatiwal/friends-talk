# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ─────────────────────────────────────────────────────────────
# MongoDB
# ─────────────────────────────────────────────────────────────
# A connection string for anything other than a local server contains a
# username and password. Keep it server-side only — this value must never be
# compiled into anything the browser downloads.
#
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#
# If the database is unreachable the server still starts and falls back to
# in-memory storage, so a dead cluster degrades the service instead of
# stopping it. Watch the boot log to see which mode is live.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=wavelength

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
PORT=3000

# ─────────────────────────────────────────────────────────────
# WebRTC relay (TURN)
# ─────────────────────────────────────────────────────────────
# STUN alone fails for roughly 10-20% of users behind strict NATs. Without a
# TURN server those calls simply never connect.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ─────────────────────────────────────────────────────────────
# Moderation
# ─────────────────────────────────────────────────────────────
# Optional. When set, shared images are additionally screened by the OpenAI
# moderation endpoint. Local screening always runs regardless.
OPENAI_API_KEY=

# Bearer token guarding GET /api/moderation/reports. Unset means the route
# returns 404 — leave it unset unless you are actually using it.
MODERATION_TOKEN=
