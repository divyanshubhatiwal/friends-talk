# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ─────────────────────────────────────────────────────────────
# MongoDB
# ─────────────────────────────────────────────────────────────
# A connection string for anything other than a local server contains a
# username and password. Keep it server-side only — this value must never be
# compiled into anything the browser downloads.
#
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#
# If the database is unreachable the server still starts and falls back to
# in-memory storage, so a dead cluster degrades the service instead of
# stopping it. Watch the boot log to see which mode is live.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=friends-talk

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
PORT=3000

# ─────────────────────────────────────────────────────────────
# WebRTC relay (TURN)
# ─────────────────────────────────────────────────────────────
# STUN alone fails for roughly 10-20% of users behind strict NATs. Without a
# TURN server those calls simply never connect.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ─────────────────────────────────────────────────────────────
# Moderation
# ─────────────────────────────────────────────────────────────
# Either provider powers three things at once, all of which stay off with no
# key set:
#   - image moderation (on top of the local screening, which always runs)
#   - live captions and translation
#   - moderation of the spoken word
#
# Set ONE of them. Gemini is preferred when both are present: it takes audio
# directly and can transcribe and translate in a single request, where OpenAI
# needs Whisper for the audio plus a second chat call for the translation.
#
# Without any key the app still works completely: calls connect, text and images
# are still screened locally, and the caption controls are hidden rather than
# shown as a switch that does nothing.
#
# Note the privacy trade-off: captions send short clips of the speaker's
# microphone to the server to be transcribed. That is why the feature is opt-in
# per user and documented on the /privacy page. Leave captions off and audio
# never touches the server at all.
#
# Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional model overrides.
# Gemini default: gemini-2.0-flash
GEMINI_MODEL=
# OpenAI defaults: whisper-1 and gpt-4o-mini
TRANSCRIBE_MODEL=
TRANSLATE_MODEL=

# Bearer token guarding GET /api/moderation/reports. Unset means the route
# returns 404 — leave it unset unless you are actually using it.
MODERATION_TOKEN=
